diff --git a/src/browser/frame/persona.js b/src/browser/frame/persona.js
new file mode 100644
index 0000000..d3eea2d
--- /dev/null
+++ b/src/browser/frame/persona.js
@@ -0,0 +1,140 @@
+// Built-in Chrome persona shim for the patched Lightpanda build.
+//
+// This runs in every document realm before any page script. It only fills the
+// gaps that are not covered by the native Zig patches (UA, platform, vendor,
+// client hints, hardware values). Canvas and WebGL are intentionally not faked
+// here: Lightpanda's 2D context is still a stub, and a fake raster is easier to
+// detect than an honest gap.
+(() => {
+  try {
+    const pluginData = [
+      { name: "PDF Viewer", filename: "internal-pdf-viewer", description: "Portable Document Format" },
+      { name: "Chrome PDF Viewer", filename: "internal-pdf-viewer", description: "Portable Document Format" },
+      { name: "Chromium PDF Viewer", filename: "internal-pdf-viewer", description: "Portable Document Format" },
+      { name: "Microsoft Edge PDF Viewer", filename: "internal-pdf-viewer", description: "Portable Document Format" },
+      { name: "WebKit built-in PDF", filename: "internal-pdf-viewer", description: "Portable Document Format" },
+    ];
+
+    const makePlugin = (data) => {
+      const plugin = {
+        name: data.name,
+        filename: data.filename,
+        description: data.description,
+        length: 0,
+        item: () => null,
+        namedItem: () => null,
+      };
+      try {
+        if (typeof Plugin !== "undefined") Object.setPrototypeOf(plugin, Plugin.prototype);
+      } catch (e) {}
+      return plugin;
+    };
+
+    const plugins = {};
+    pluginData.forEach((data, index) => { plugins[index] = makePlugin(data); });
+    Object.defineProperty(plugins, "length", { value: pluginData.length, enumerable: false });
+    plugins.item = (index) => plugins[index] || null;
+    plugins.namedItem = (name) => {
+      for (let i = 0; i < pluginData.length; i++) {
+        if (pluginData[i].name === name) return plugins[i];
+      }
+      return null;
+    };
+    plugins.refresh = () => {};
+    try {
+      if (typeof PluginArray !== "undefined") Object.setPrototypeOf(plugins, PluginArray.prototype);
+    } catch (e) {}
+
+    const mimeData = [
+      { type: "application/pdf", suffixes: "pdf", description: "Portable Document Format" },
+      { type: "text/pdf", suffixes: "pdf", description: "Portable Document Format" },
+    ];
+    const mimeTypes = {};
+    mimeData.forEach((data, index) => {
+      mimeTypes[index] = {
+        type: data.type,
+        suffixes: data.suffixes,
+        description: data.description,
+        enabledPlugin: plugins[0],
+      };
+    });
+    Object.defineProperty(mimeTypes, "length", { value: mimeData.length, enumerable: false });
+    mimeTypes.item = (index) => mimeTypes[index] || null;
+    mimeTypes.namedItem = (name) => {
+      for (let i = 0; i < mimeData.length; i++) {
+        if (mimeData[i].type === name) return mimeTypes[i];
+      }
+      return null;
+    };
+    try {
+      if (typeof MimeTypeArray !== "undefined") Object.setPrototypeOf(mimeTypes, MimeTypeArray.prototype);
+    } catch (e) {}
+
+    Object.defineProperty(Navigator.prototype, "plugins", { get: () => plugins, configurable: true });
+    Object.defineProperty(Navigator.prototype, "mimeTypes", { get: () => mimeTypes, configurable: true });
+    Object.defineProperty(Navigator.prototype, "pdfViewerEnabled", { get: () => true, configurable: true });
+    Object.defineProperty(Navigator.prototype, "connection", {
+      get: () => ({ effectiveType: "4g", rtt: 50, downlink: 10, saveData: false, onchange: null }),
+      configurable: true,
+    });
+  } catch (e) {}
+
+  try {
+    const chromeObject = {
+      runtime: {
+        id: undefined,
+        connect: () => ({
+          onMessage: { addListener: () => {}, removeListener: () => {} },
+          postMessage: () => {},
+          disconnect: () => {},
+        }),
+        sendMessage: () => {},
+      },
+      app: {
+        isInstalled: false,
+        InstallState: { DISABLED: "disabled", INSTALLED: "installed", NOT_INSTALLED: "not_installed" },
+        RunningState: { CANNOT_RUN: "cannot_run", READY_TO_RUN: "ready_to_run", RUNNING: "running" },
+        getDetails: () => null,
+        getIsInstalled: () => false,
+      },
+      csi: () => ({ startE: 0, onloadT: 0, pageT: 0, tran: 15 }),
+      loadTimes: () => ({
+        requestTime: 0,
+        startLoadTime: 0,
+        commitLoadTime: 0,
+        finishDocumentLoadTime: 0,
+        finishLoadTime: 0,
+        firstPaintTime: 0,
+        firstPaintAfterLoadTime: 0,
+        navigationType: "Other",
+        wasFetchedViaSpdy: true,
+        wasNpnNegotiated: true,
+        npnNegotiatedProtocol: "h2",
+        wasAlternateProtocolAvailable: false,
+        connectionInfo: "h2",
+      }),
+    };
+    Object.defineProperty(window, "chrome", { value: chromeObject, configurable: true, enumerable: true });
+  } catch (e) {}
+
+  try {
+    const screenValues = {
+      width: 1920,
+      height: 1080,
+      availWidth: 1920,
+      availHeight: 1040,
+      colorDepth: 24,
+      pixelDepth: 24,
+    };
+    for (const key of Object.keys(screenValues)) {
+      Object.defineProperty(Screen.prototype, key, { get: () => screenValues[key], configurable: true });
+    }
+  } catch (e) {}
+
+  try {
+    const windowValues = { outerWidth: 1280, outerHeight: 720, innerWidth: 1280, innerHeight: 720 };
+    for (const key of Object.keys(windowValues)) {
+      Object.defineProperty(Window.prototype, key, { get: () => windowValues[key], configurable: true });
+    }
+  } catch (e) {}
+})();
